{
  "name": "steed",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun scripts/run-diagram-e2e.ts && bun scripts/run-connect-e2e.ts",
    "release": "bun scripts/release.ts",
    "check-coverage": "bun scripts/check-coverage.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "overrides": {
    "postcss": "8.5.23",
    "brace-expansion": "5.0.12",
    "ws": "^8.21.0",
    "esbuild": "^0.28.1",
    "undici": "7.30.1",
    "@humanfs/node": "0.16.8",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "minimatch": "11.0.1"
  }
}
