{
  "name": "steed",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "build": "bun run --cwd apps/web build",
    "deploy:worker": "bun run --cwd packages/worker deploy",
    "start": "bun run --cwd apps/web preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun scripts/run-e2e.ts",
    "check-coverage": "bun scripts/check-coverage.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "overrides": {
    "postcss": "8.5.23",
    "brace-expansion": "5.0.9",
    "ws": "^8.21.0",
    "esbuild": "^0.28.1",
    "undici": "7.29.0",
    "@humanfs/node": "0.16.8",
    "nanoid": "3.3.18",
    "sharp": "0.35.4",
    "next": "16.3.4",
    "baseline-browser-mapping": "2.11.0"
  }
}
