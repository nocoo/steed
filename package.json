{
  "name": "steed",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "build": "bun run --cwd apps/web build",
    "deploy:worker": "bun run --cwd packages/worker deploy",
    "start": "bun run --cwd apps/web preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun scripts/run-e2e.ts",
    "check-coverage": "bun scripts/check-coverage.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "overrides": {
    "postcss": "^8.5.10",
    "brace-expansion": "^5.0.6",
    "ws": "^8.20.1",
    "esbuild": "^0.28.1"
  }
}
