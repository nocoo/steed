    { "id": "jobs", "label": "Background jobs", "kind": "service", "groupId": "compute", "position": { "x": 360, "y": 360 } },
    { "id": "db", "label": "Application database", "kind": "database", "groupId": "data", "position": { "x": 760, "y": 100 } },
