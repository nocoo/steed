    { "id": "data", "label": "Private data", "parentId": "cloud" },
    { "id": "unused", "label": "Reserved boundary" }
  ],
  "nodes": [
    { "id": "client", "label": "Browser", "kind": "client", "position": { "x": 0, "y": 150 } },
